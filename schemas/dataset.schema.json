{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Advocate Benchmark Dataset",
  "description": "팀 논의와 초기 연동을 위한 공용 스키마 초안입니다.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "module", "messages", "expected_stance", "checks"],
    "properties": {
      "id": {
        "description": "테스트 케이스 고유 ID",
        "type": "string",
        "minLength": 1
      },
      "module": {
        "enum": ["logical", "selective", "context", "evidence_updating"]
      },
      "messages": {
        "description": "평가 대상 Agent에 순서대로 전달할 사용자 발언",
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "expected_stance": {
        "description": "마지막 사용자 발언에 대한 기대 행동",
        "enum": ["agree", "challenge", "clarify", "maintain", "revise"]
      },
      "checks": {
        "description": "케이스별 채점 기준 문장 4개",
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
